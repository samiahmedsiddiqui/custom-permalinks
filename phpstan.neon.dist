parameters:
	level: 5
	treatPhpDocTypesAsCertain: false
	phpVersion:
		min: 70400
		max: 80599
	paths:
		- custom-permalinks.php
		- uninstall.php
		- admin
		- includes
	bootstrapFiles:
		- .phpstan/bootstrap.php
	ignoreErrors:
		# Defensive checks on values WordPress or other plugins may pass as null.
		- identifier: isset.property
		- identifier: isset.offset
		# Singleton instance() used as a load-{page} callback.
		-
			identifier: return.void
			path: admin/class-custom-permalinks-admin.php
